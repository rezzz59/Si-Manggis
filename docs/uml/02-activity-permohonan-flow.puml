@startuml SiManggis-PermohonanFlow
!theme plain

|#wheat|Warga|
start
:Kirim form permohonan
(nama, NIK, alamat, telepon,
jenis layanan, nomor RT);

|#lightblue|Sistem|
:Validasi input;
:Generate tiket unik;
:Simpan ke DB (status: MENUNGGU);
:Kirim WA ke RT via Fonnte;

|Sistem|
note right
  Kirim notif WA ke no_wa_rt RT.
  Isi: data warga + Tiket + instruksi
  BALAS "SETUJU" / "TOLAK [alasan]"
end note

|#lightgreen|RT|
:Kirim notif ke nomor WA RT;

|RT|
:Balas WA "SETUJU"\nou "TOLAK [alasan]";

|WhatsApp|
:Terima balasan;

|Sistem|
:Webhook terima balasan;
:Parse pesan;
:Cocokkan RT dengan
permohonan terbaru;

if (Pesan valid?) then (<color:green>Ya)
  :Update status:
  - DISETUJAI_RT, atau
  - DITOLAK_RT;
  :Log ke laporan_status_log;
  if (SETUJU) then
    :Kirim notif ke
    KELURAHAN_WA_NUMBER;
  else (TOLAK)
  endif
else (Bukan approval valid)
  :Abaikan;
  stop
endif

|#lightyellow|Staff Kelurahan|
:Login dashboard;
:Filter permohonan DISETUJAI_RT;
:Update status DIPROSES;
:Generate surat;
:Upload surat_url;
:Update status SELESAI;
:Sistem log perubahan;

|Warga|
:Kunjungi /cek-tiket;
:Masukkan nomor tiket;
:Lihat status terkini;

stop

@enduml
