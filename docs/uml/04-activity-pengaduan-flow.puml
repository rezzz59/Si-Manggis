@startuml SiManggis-PengaduanFlow
!theme plain

|#wheat|Warga|
start
:Mengisi form pengaduan
(nama, telepon, email, topik, pesan);
:Kirim pengaduan;

|#lightblue|Sistem|
:Validasi input;
:Generate nomor tiket unik;
:Simpan ke tabel pengaduan
(status: MENUNGGU);

note right
  Endpoint: POST /api/pengaduan
  Auth: TIDAK (public)
  TIDAK ada approval RT
end note

|#lightyellow|Staff Kelurahan|
:Login ke dashboard;
:Buka menu Pengaduan;
:Lihat daftar pengaduan
(filter: status);
:Klik detail pengaduan;
:Proses pengaduan;
:Update status DIPROSES;
:Update status SELESAI
(atau DITOLAK);

|Sistem|
:Log perubahan status;

|#wheat|Warga|
:Kunjungi /cek-tiket;
:Masukkan nomor tiket;
:Lihat status terkini;

stop

note bottom
  Alur status pengaduan:
  MENUNGGU → DIPROSES → SELESAI
            ↘ DITOLAK

  Perbedaan dengan Permohonan:
  - Pengaduan TIDAK perlu persetujuan RT
  - Langsung masuk dashboard staff
end note

@enduml
