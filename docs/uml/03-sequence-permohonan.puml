@startuml
skinparam backgroundColor #FEFCF3

title Si-Manggis — Sequence Diagram: End-to-End Permohonan (RT Punya WA)\n\nactor Warga order 10
participant "Frontend\n/Web" as FE order 20
participant "API Route\n/api/permohonan" as API order 30
participant "Supabase DB" as DB order 40
participant "Fonnte API" as FONNTE order 50
participant "WhatsApp RT" as WA_RT order 60
participant "Fonnte\nWebhook" as WHK order 65
participant "Staff\nDashboard" as STAFF order 70

Warga -> FE : 1. Isi & submit form permohonan\n(nama, NIK, alamat, telepon, RT, jenis)
FE -> API : 2. POST /api/permohonan\n(form data)

alt RT = punya WA (no_wa_rt != NULL)
  API -> DB : 3. Insert permohonan\n(MENUNGGU, generate tiket)

  alt Sukses
    API -> FONNTE : 4. POST sendWA()\n(target: no_wa_rt RT,\npesan: notifikasi permohonan)
    FONNTE -> WA_RT : 5. WhatsApp message\n🔔 Laporan Baru RT [xx]
    WA_RT -> WA_RT : 6. RT baca pesan

    alt RT balas SETUJU
      WA_RT -> WHK : 7. Kirim teks "SETUJU"\n(kirim WA balik ke nomor Fonnte)
      WHK -> API : 8. POST /api/fonnte/webhook\n(from, "SETUJU")
      API -> DB : 9. UPDATE status\n→ DISETUJAI_RT
      API -> DB : 10. INSERT\nlaporan_status_log
      API -> FONNTE : 11. CONFIRM WA\nke RT
    else RT balas TOLAK [alasan]
      WA_RT -> WHK : 7b. Kirim teks "TOLAK [alasan]"
      WHK -> API : 8b. POST /api/fonnte/webhook\n(from, "TOLAK [alasan]")
      API -> DB : 9b. UPDATE status\n→ DITOLAK_RT
      API -> DB : 10b. INSERT\nlaporan_status_log
      API -> FONNTE : 11b. CONFIRM WA\nke RT
    end

  else Gagal insert
    API -> FE : 9x. ERROR 500\n"Terjadi kesalahan"
  end

else RT = tanpa WA (no_wa_rt == NULL)
  API -> DB : 3n. Insert permohonan\n(status: MENUNGGU, generate tiket)
  API -> STAFF : 4n. ✅ Tampil di dashboard\ndengan badge "⚠️ RT tanpa WA"

  note right API
    Tidak kirim WA
    Staff harus telepon RT
  end note

  == Staff telepon RT manual ==

  activate STAFF
  STAFF -> WA_RT : 5n. Staff TELEPON RT\n"Apakah approve permohonan Budi?"
  deactivate STAFF

  alt RT Setuju via telepon
    WA_RT -> STAFF : 6n. RT Setuju\n(via telepon suara)
    STAFF -> DB : 7n. Ubah status\n→ DISETUJAI_RT + note
  else RT Tolak via telepon
    WA_RT -> STAFF : 6nb. RT Tolak\n(via telepon suara)
    STAFF -> DB : 7nb. Ubah status\n→ DITOLAK_RT + alasan
  end
end

== Proses oleh Staff ==

STAFF -> DB : 13. Proses surat\nUPDATE → DIPROSES
STAFF -> FONNTE : 14. WA ke warga:\n"Surat sedang diproses"
FONNTE -> Warga : 15. Notifikasi WA\nke warga

STAFF -> DB : 16. Surat selesai\nUPDATE → SELESAI
STAFF -> FONNTE : 17. WA ke warga:\n"Surat siap diambil"
FONNTE -> Warga : 18. ✅ WA sukses\nke warga

Warga -> FE : 19. Cek tiket\n/cek-tiket
FE -> API : 20. GET /api/cek-tiket/[tiket]
API -> DB : 21. SELECT by tiket\n& status permohonan
DB --> FE : 22. Data tiket & status\nSELESAI

@enduml