@startuml
skinparam backgroundColor #FEFCF3
skinparam handwritten true

title Si-Manggis — Use Case Diagram

left to right direction

actor "Warga" as W
actor "RT 01-52" as RT
actor "Staff Kelurahan" as S
actor "Fonnte API" as F

rectangle "Si-Manggis System" {
  usecase "UC-1: Submit Permohonan Layanan" as UC1
  usecase "UC-2: Submit Pengaduan" as UC2
  usecase "UC-3: Cek Status via Tiket" as UC3
  usecase "UC-4: Baca Artikel & Berita" as UC4

  usecase "UC-5: Approve Permohonan via WA" as UC5
  usecase "UC-6: Tolak Permohonan via WA" as UC6
  usecase "UC-7: Terima Telepon dari Staff" as UC7

  usecase "UC-8: Login Dashboard" as UC8
  usecase "UC-9: Kelola Permohonan" as UC9
  usecase "UC-10: Kelola Pengaduan" as UC10
  usecase "UC-11: Hubungi RT via Telepon" as UC11
  usecase "UC-12: Update Status" as UC12
  usecase "UC-13: Kirim WA ke Warga" as UC13
  usecase "UC-14: Kelola Konten Website" as UC14

  usecase "UC-15: Kirim Notifikasi WA" as UC15
  usecase "UC-16: Terima Balasan WA" as UC16
}

W --> UC1
W --> UC2
W --> UC3
W --> UC4

RT --> UC5
RT --> UC6
RT --> UC7

S --> UC8
S --> UC9
S --> UC10
S --> UC11
S --> UC12
S --> UC13
S --> UC14

F --> UC15
F --> UC16

UC1 ..> UC15 : extends
UC9 ..> UC12 : extends
UC9 ..> UC11 : includes
UC9 ..> UC13 : includes

note right of UC1
  Wargasubmit tanpa login
  Pilih RT, jenis layanan
  Dapat nomor tiket
end note

note right of UC5
  RT punya WhatsApp
  balas "SETUJU" atau "TOLAK [alasan]"
end note

note right of UC7
  RT tidak punya WhatsApp
  Staff Kelurahan telepon manual
end note

note right of UC9
  Staff Kelurahan melihat
  semua permohonan di dashboard
  ubah status: DIPROSES / SELESAI
end note

@enduml