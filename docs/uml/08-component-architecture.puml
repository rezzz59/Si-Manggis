@startuml SiManggis-Component
!theme plain

package "🖥️ Client Layer" {
  [Web Browser\n(Tailwind CSS, React 19)] as browser
  [WhatsApp App\n(RT & Staff)] as whatsapp
}

package "📱 Next.js App Router\n(Server + Client)" as nextjs {
  package "Page Routes" {
    [/\nHomepage publik] as home
    [/layanan\nForm permohonan] as formPerm
    [/laporan\nForm pengaduan] as formPeng
    [/cek-tiket\nLacak status] as cekTiket
    [/login\nStaff login] as login
    [/dashboard\nStaff protected] as dash
    [/dashboard/permohonan\nManage permohonan] as dashPerm
    [/dashboard/pengaduan\nManage pengaduan] as dashPeng
    [/dashboard/homepage\nCMS homepage] as dashHome
    [/dashboard/aset\nAsset manager] as dashAset
  }

  package "API Routes" {
    [POST /api/permohonan\nPublic: warga submit] as apiPermPost
    [GET/PATCH /api/permohonan\nAuth: staff only] as apiPermAuth
    [POST /api/pengaduan\nPublic: warga submit] as apiPengPost
    [GET/PATCH /api/pengaduan\nAuth: staff only] as apiPengAuth
    [GET /api/cek-tiket/:tiket\nPublic: warga cek status] as apiCek
    [POST /api/fonnte/webhook\nFonnte callback] as apiWebhook
    [POST /api/fonnte/send\nAdmin WA send] as apiSend
    [GET /api/rt\nPublic: RT list] as apiRT
    [GET/POST /api/artikel\nPublic read, admin write] as apiArt
    [GET/PUT /api/homepage\nPublic read, admin write] as apiHome
    [GET/POST/PATCH/DELETE /api/assets\nAsset CRUD] as apiAssets
    [GET/PATCH/DELETE /api/assets/:id\nAsset by ID] as apiAssetId
  }

  package "Server Components" {
    [src/lib/auth.ts\nNext-Auth v5 config] as authLib
    [src/lib/supabase.ts\nClient Supabase] as supaClient
    [src/lib/supabase-admin.ts\nAdmin Supabase] as supaAdmin
    [src/lib/fonnte.ts\nFonnte WA sender] as fonnteLib
    [src/lib/fonnte-parser.ts\nWA message parser] as fonnteParser
    [src/lib/tiket.ts\nTiket generator] as tiketLib
  }
}

package "🌐 Supabase Backend" {
  database "PostgreSQL\n(Row Level Security)" as pg {
    table "staff"
    table "rt"
    table "permohonan"
    table "pengaduan"
    table "laporan_status_log"
    table "website_assets"
    table "homepage_config"
    table "artikel"
  }

  storage "Supabase Storage\n(website-assets bucket)" as storage
  auth "Supabase Auth\n(Next-Auth JWT)" as supaAuth
}

package "📱 Fonnte API\n(WhatsApp Gateway)" as fonnte {
  [POST send message] as fonnteSend
  [Webhook inbound] as fonnteWebhook
}

' ===== CONNECTIONS =====

browser --> home
browser --> formPerm
browser --> formPeng
browser --> cekTiket
browser --> login

' Page → API calls
formPerm ..> apiPermPost : warga submit
formPeng ..> apiPengPost : warga submit
cekTiket ..> apiCek : cek status
dash ..> apiPermAuth : manage
dash ..> apiPengAuth : manage
dashHome ..> apiHome : edit homepage
dashAset ..> apiAssets : upload assets

' Next-Auth
login --> authLib

' Auth middleware
authLib --> supaAuth

' API → Supabase
apiPermPost --> supaClient --> pg
apiPermAuth --> supaClient
apiPengPost --> supaClient
apiPengAuth --> supaClient
apiCek --> supaClient
apiArt --> supaAdmin
apiHome --> supaAdmin
apiAssets --> supaAdmin
apiAssetId --> supaAdmin

' Fonnte integration
apiPermPost --> fonnteLib --> fonnteSend --> fonnte
fonnteWebhook --> apiWebhook --> supaClient
whatsapp --> fonnteWebhook
fonnteSend --> whatsapp

' Storage
apiAssets --> storage

' Notes
note top of apiPermPost
  Endpoint: POST /api/permohonan
  Auth: TANPA LOGIN
  ⚠️ Perlu: nomor_rt validation
  ⚠️ Perlu: rate limiting
end note

note top of apiPengPost
  Endpoint: POST /api/pengaduan
  Auth: TANPA LOGIN
  ⚠️ Perlu: email validation
  ⚠️ Perlu: rate limiting
end note

note top of apiWebhook
  Endpoint: POST /api/fonnte/webhook
  Auth: TANPA TOKEN VERIFIKASI ⚠️
  ⚠️ Perlu: signature/token check
end note

note top of supaClient
  ⚠️ CRITICAL SECURITY:
  Menggunakan SUPABASE_SERVICE_KEY
  (service role) di client-side
  → RLS policies tidak berfungsi
  → Semua data accessible oleh browser
end note

note bottom of nextjs
  Middleware: protects /dashboard/*\nprotects /api/permohonan/* (except POST)\nprotects /api/pengaduan/* (except POST)
end note

@enduml